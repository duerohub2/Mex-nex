# MEX-NEX — konfigurasi server lokal
HOST=127.0.0.1
PORT=3000
MEX_NEX_DATA_DIR=.data

# Provider AI: hermes | local | external
AI_PROVIDER=hermes
HERMES_BASE_URL=http://127.0.0.1:8000
HERMES_MODEL=your-model-name
HERMES_API_KEY=

# Model lokal OpenAI-compatible, misalnya Ollama
LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434
LOCAL_MODEL_NAME=llama3.2
LOCAL_MODEL_API_KEY=

# Provider eksternal OpenAI-compatible
EXTERNAL_AI_BASE_URL=
EXTERNAL_AI_MODEL=
EXTERNAL_AI_API_KEY=
AI_REQUEST_TIMEOUT_MS=120000

# Hermes3D / gateway kantor virtual
NEXT_PUBLIC_GATEWAY_URL=ws://localhost:18789
# HERMES3D_GATEWAY_URL=ws://localhost:18789
# HERMES3D_GATEWAY_TOKEN=
# HERMES3D_GATEWAY_ADAPTER_TYPE=hermes
# HERMES_API_URL=http://localhost:8642
# HERMES_API_KEY=
# HERMES_MODEL=hermes-agent
DEBUG=false

# Akses deployment publik (opsional)
# STUDIO_ACCESS_TOKEN=

# SSH gateway (opsional)
# HERMES_GATEWAY_SSH_TARGET=
# HERMES_GATEWAY_SSH_USER=
# HERMES_GATEWAY_SSH_PORT=
# HERMES_GATEWAY_SSH_STRICT_HOST_KEY_CHECKING=accept-new

# Adapter Hermes / demo
# HERMES_ADAPTER_PORT=18789
# HERMES_AGENT_NAME=Hermes
# DEMO_ADAPTER_PORT=18789

# Fitur suara opsional
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
