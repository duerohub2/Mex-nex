# Server lokal
HOST=127.0.0.1
PORT=3000
MEX_NEX_DATA_DIR=.data

# Pilih: hermes | local | external
AI_PROVIDER=hermes

# Hermes Agent / Hermes-compatible API (OpenAI Chat Completions)
HERMES_BASE_URL=http://127.0.0.1:8000
HERMES_MODEL=your-model-name
HERMES_API_KEY=

# Model lokal dengan endpoint OpenAI-compatible (contoh: Ollama)
LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434
LOCAL_MODEL_NAME=llama3.2
LOCAL_MODEL_API_KEY=

# Provider eksternal yang menyediakan /v1/chat/completions
EXTERNAL_AI_BASE_URL=
EXTERNAL_AI_MODEL=
EXTERNAL_AI_API_KEY=

# Timeout permintaan AI (ms)
AI_REQUEST_TIMEOUT_MS=120000
